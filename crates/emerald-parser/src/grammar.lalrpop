use crate::ast::{
  ActorDef, CaseArm, CasePattern, ClassDef, CompareOp, Contract, EnumDef, EnumVariant,
  ExternBlock, ExternFn, Expr, Function, InterfaceDef, Item, ModuleDef, Param, Program,
  RescueClause, Spanned, Stmt, TypeParam,
};
use crate::ast::decode_string_lit;
use crate::interpolate;

// Plan 26: a grammar-level parameter, threaded as an extra argument
// into every generated parser entry point (`ProgramParser::parse`
// included) — this is how LALRPOP's `!` error-recovery mechanism
// actually surfaces recovered errors to the caller (each `!`
// alternative below implicitly pushes its `ErrorRecovery` here; see
// `Item`'s own `! => Item::Error` production).
grammar(errors: &mut Vec<lalrpop_util::ErrorRecovery<usize, lalrpop_util::lexer::Token<'input>, String>>);

// LALRPOP's `=>?` fallible actions default to a `&'static str` user-error
// type; the assignment-target check below wants an interpolated message
// (`format!`), so this widens it to `String`.
extern {
  type Error = String;
}

match {
  r"\s*" => { },
  // Plan 20: `#` through end-of-line (newline excluded, so line/
  // statement boundaries are unaffected) — usable anywhere trailing
  // whitespace already can be, including at the end of a code line.
  // No `.em` program can contain a string literal with a `#` in it at
  // the time this pattern was added (see plan 20's Decision log for
  // the note future string-literal work needs to re-check this
  // against); LALRPOP's `match` block is priority-ordered top to
  // bottom, so a later string-literal pattern placed *above* this one
  // would take precedence for a `#` inside `"..."`.
  r"#[^\n]*" => { },
  _
}

pub Program: Program = {
  <items:Item*> => Program { items }
};

// Plan 26: `!` is LALRPOP's own built-in error-recovery marker — on a
// syntax error here, it skips tokens (panic-mode) until it can
// resynchronize at the start of the next `Item`, recording an
// `ErrorRecovery` instead of aborting the whole parse. Scoped to this
// top-level boundary only, not inside any `Stmt*` list (a function
// body, an `if`/`while` block, etc.) — see the Decision log for why a
// narrower first cut is the right one.
Item: Item = {
  <f:FuncDef> => Item::Function(f),
  <c:ClassDef> => Item::Class(c),
  <a:ActorDef> => Item::Actor(a),
  <m:ModuleDef> => Item::Module(m),
  <i:InterfaceDef> => Item::Interface(i),
  <e:EnumDef> => Item::Enum(e),
  <x:ExternBlockDef> => Item::Extern(x),
  <s:Stmt> => Item::Stmt(s),
  // Plan 23: reachable only here, at the top-level `Item` rule — never
  // from `Stmt`/`Stmt*`, so `require` inside a function/`if`/`while`
  // body is a real parse error, not silently accepted.
  "require" <path:RequirePath> => Item::Require(path),
  // Plan 47's Decision log: `test "..." do ... end` gets its own
  // narrow production (a real, new "do" terminal) — not plan 34's
  // general `{ |params| body }` block syntax, which explicitly
  // declined a `do...end` form.
  "test" <description:StringLitTok> "do" <body:Stmt*> "end" => Item::Test { description, body },
  ! => { errors.push(<>); Item::Error },
};

// `foo/bar/baz` — reuses `Ident` and the already-declared `"/"`
// terminal (division's own token) rather than inventing a new regex
// that would overlap `Ident`'s own pattern and risk lexer ambiguity
// (plan 23's Decision log calls for a bare, unquoted, `/`-separated
// path — this gets that without a new terminal at all).
RequirePath: String = {
  <first:Ident> => first,
  <first:Ident> "/" <rest:RequirePath> => format!("{first}/{rest}"),
};

// A class body's field declarations reuse the `Param` rule directly
// (`x: Float64` is structurally identical whether it's a field or a
// parameter) — fields and methods have disjoint FIRST sets (`Ident` vs
// `"def"`), so `Param*` followed by `FuncDef*` is unambiguous.
ClassDef: ClassDef = {
  // Plan 58's Decision log: `<type_params:TypeParamClause?>` slots in
  // immediately after the class name, before `SuperclassClause?` —
  // reuses `TypeParamClause`/`TypeParamList` (plan 41's own generic-
  // function `[T: Bound]` clause) verbatim, no new grammar production.
  "class" <name:Ident> <type_params:TypeParamClause?> <superclass:SuperclassClause?> <implements:ImplementsClause?> <derive:DeriveClause?> <class_fields:ClassField*> <methods:MethodDef*> "end" => {
    let mut fields = Vec::new();
    let mut all_methods = Vec::new();
    for (p, synthesized) in class_fields {
      fields.push(p);
      all_methods.extend(synthesized);
    }
    all_methods.extend(methods);
    ClassDef { name, superclass, implements, derive, fields, methods: all_methods, type_params: type_params.unwrap_or_default() }
  }
};

// `class Money implements Comparable` (plan 41's Decision log) — a
// single interface name, not a list; reachable only from `ClassDef`
// (never `ModuleDef`), enforcing "modules cannot declare `implements`"
// structurally rather than as a separately-checked sema invariant.
ImplementsClause: String = {
  "implements" <i:Ident> => i,
};

// `class Point derive Comparable` (plan 61's Decision log) — mirrors
// `ImplementsClause` exactly: a single, arbitrary `Ident`, not restricted
// to a fixed keyword set at the grammar level (`emerald_parser::
// expand_derives` rejects any name other than `"Comparable"` with a real
// diagnostic naming it, the same "grammar stays general, a later pass
// narrows" split `ImplementsClause`'s own class-only reachability
// already uses).
DeriveClause: String = {
  "derive" <i:Ident> => i,
};

// Plan 33: an opt-in `read <name>: <Type>` field marker synthesizes a
// zero-arg accessor method returning `@<name>` (Decision log) — a pure
// parse-time desugaring, `Param`/`ClassDef`'s shapes are unchanged;
// `fields` still gets the same plain, unmarked `Param` either way.
// `read` is reserved the same LALR(1) way every other class-body
// keyword already is.
ClassField: (Param, Vec<Function>) = {
  <p:Param> => (p, vec![]),
  "read" <p:Param> => {
    let accessor = Function {
      name: p.name.clone(),
      params: vec![],
      return_type: p.ty.clone(),
      body: vec![Spanned::synthetic(Stmt::Expr(Spanned::synthetic(Expr::InstanceVar(p.name.clone()))))],
      block_param: None,
      splat_param: None,
      type_params: Vec::new(),
      is_comptime: false,
      requires: Vec::new(),
      ensures: Vec::new(),
      is_pure: false,
    };
    (p, vec![accessor])
  },
};

// `class Dog < Animal` (plan 32's Decision log). Reuses the already-
// declared `"<"` terminal (`CompareOp`'s less-than) — distinct enough
// from `Ident`/`"def"`/`"end"` (the only tokens that can otherwise
// follow a class name) that there's no FIRST-set overlap to disambiguate.
SuperclassClause: String = {
  "<" <s:Ident> => s,
};

// Namespace-only (plan 12's Decision log) — no fields, just methods.
// `module` is reserved the same LALR(1) way `class`/`def` already are.
ModuleDef: ModuleDef = {
  "module" <name:Ident> <methods:FuncDef*> "end" => ModuleDef { name, methods }
};

// `actor Counter ... end` (plan 54's Decision log) — structurally
// identical to `ClassDef` above minus `SuperclassClause?`/
// `ImplementsClause?`: no optional `"<" Ident` clause exists in this
// production at all, so `actor Dog < Animal ... end` is a real, direct
// parse error (the same category of failure as `module Dog < Animal
// ... end` today), not a semantic rejection of an otherwise-parseable
// shape. `actor` is reserved the same LALR(1) way `class`/`module`/
// `def` already are.
ActorDef: ActorDef = {
  "actor" <name:Ident> <actor_fields:ClassField*> <methods:MethodDef*> "end" => {
    let mut fields = Vec::new();
    let mut all_methods = Vec::new();
    for (p, synthesized) in actor_fields {
      fields.push(p);
      all_methods.extend(synthesized);
    }
    all_methods.extend(methods);
    ActorDef { name, fields, methods: all_methods }
  }
};

// Plan 61's Decision log: `<comptime:"comptime"?>` slots in before
// `"def"` — grammatically reachable on every `FuncDef` (a top-level
// function AND, since `ModuleDef` also calls this same production, a
// module method too), even though only a top-level function's
// `is_comptime: true` is ever accepted: `emerald-sema` rejects one found
// on a module method with a real "comptime functions must be top-level"
// diagnostic, mirroring `type_params`'s own top-level-only precedent
// (`MethodDef`'s identical mirror below) exactly.
// Plan 62's Decision log: `<contracts:ContractClause*>` slots in between
// `-> TypeName` and `Stmt*` — the one open slot `FuncDef`'s own
// production has, with no FIRST-set overlap to disambiguate ("requires"/
// "ensures" are brand-new reserved keywords, the same "reserve a new
// keyword the same LALR(1) way class/def/interface/actor already are"
// idiom this file's own comments describe for every prior reserved
// word). Reachable only here, never from `MethodDef` — a real, stricter
// cut than `type_params`'s own "grammatically reachable on methods,
// sema-rejected" precedent, since methods reject a non-empty `requires`/
// `ensures` in sema regardless (see the Decision log for why the
// grammar-level fence is simpler here).
FuncDef: Function = {
  <is_pure:"pure"?> <comptime:"comptime"?> "def" <name:Ident> <type_params:TypeParamClause?> <parts:ParenParams> "->" <return_type:TypeName> <contracts:ContractClause*> <body:Stmt*> "end" => {
    let mut requires = Vec::new();
    let mut ensures = Vec::new();
    for (is_requires, c) in contracts {
      if is_requires { requires.push(c); } else { ensures.push(c); }
    }
    Function {
      name,
      params: parts.0,
      return_type,
      body,
      block_param: parts.2,
      splat_param: parts.1,
      type_params: type_params.unwrap_or_default(),
      is_comptime: comptime.is_some(),
      requires,
      ensures,
      is_pure: is_pure.is_some(),
    }
  }
};

// `true` tags a `requires` clause, `false` an `ensures` clause — `Contract.
// text`/`line` are filled in later, by `emerald_parser::lib.rs`'s own
// `fill_contract_text` post-parse pass (mirrors plan 47's identical `loc`-
// capture technique — this grammar action only has the raw `Spanned<Expr>`
// to work with, not `source`, which LALRPOP's own generated parser entry
// point has no parameter slot for).
ContractClause: (bool, Contract) = {
  "requires" <e:Expr> => (true, Contract { expr: e, text: String::new(), line: 0 }),
  "ensures" <e:Expr> => (false, Contract { expr: e, text: String::new(), line: 0 }),
};

// `interface Comparable def compare_to(other: Self) -> Int64 end` (plan
// 41's Decision log) — structurally exactly one required method: no
// `FuncDef*`-style repetition inside `interface ... end`, so a second
// `def` before the outer `end` is a real parse error. Reuses the
// existing `Params`/`Param` rule for the method's parameter list, the
// same reuse `ClassField` already makes for class fields.
InterfaceDef: InterfaceDef = {
  "interface" <name:Ident> "def" <method_name:Ident> "(" <params:Params> ")" "->" <return_type:TypeName> "end" => {
    InterfaceDef { name, method_name, params, return_type }
  }
};

// `unsafe extern "C" { fn llabs(x: Int64): Int64 ... }` (plan 59's
// Decision log) — `unsafe` is mandatory at the grammar level, not a
// sema convention: a bare `extern "C" { ... }` with no `unsafe` is a
// real parse error, the same "unforgeable structural fence" reasoning
// `TypeParamClause`'s bound requirement documents elsewhere. `abi` is
// decoded via the same `StringLitTok` production `test`'s own
// description string already uses — a plain string literal, not a
// reserved keyword set (checked against exactly `"C"` by
// `emerald-sema`, not restricted here).
ExternBlockDef: ExternBlock = {
  "unsafe" "extern" <abi:StringLitTok> "{" <fns:ExternFnDecl*> "}" => ExternBlock { abi, fns },
};

// Deliberately `":"` rather than `FuncDef`'s own `"->"` (Decision log)
// — visually distinct from an ordinary function signature at a glance,
// on top of the mandatory `unsafe extern` prefix. Reuses the existing,
// shared `Params`/`Param` production verbatim, the same reuse
// `ClassField`/`InterfaceDef` already make.
ExternFnDecl: ExternFn = {
  "fn" <name:Ident> "(" <params:Params> ")" ":" <return_type:TypeName> => {
    ExternFn { name, params, return_type }
  }
};

// `enum Shape = Circle(Float64) | Square(Float64) | Rectangle(Float64,
// Float64)` (plan 52's Decision log) — a one-line declaration, no
// trailing `end`, the same "no block needed" shape `Stmt::Let` already
// has. `enum` is reserved the same LALR(1) way `class`/`module`/
// `interface` already are.
EnumDef: EnumDef = {
  "enum" <name:Ident> "=" <variants:EnumVariants> => EnumDef { name, variants },
};

// Mandatory-first-element, right-recursive on "|" — the same
// `CaseValues`/`MultiAssignNames`/`YieldArgs` idiom this grammar
// already uses for a separator-delimited list with no closing
// bracket to make left recursion safe.
EnumVariants: Vec<EnumVariant> = {
  <v:EnumVariant> => vec![v],
  <v:EnumVariant> "|" <rest:EnumVariants> => {
    let mut vs = vec![v];
    vs.extend(rest);
    vs
  },
};

// At least one payload field, required unconditionally — no bare,
// nullary tag variants in this plan (Decision log).
EnumVariant: EnumVariant = {
  <name:Ident> "(" <fields:TypeNameList> ")" => EnumVariant { name, fields },
};

// Left-recursive, trailing-comma list of `TypeName` — safe left
// recursion since it's always closed by a known `")"`, the same
// reasoning `Args`/`Params` already rely on.
TypeNameList: Vec<String> = {
  <mut v:(<TypeName> ",")*> <last:TypeName?> => {
    match last {
      None => v,
      Some(t) => { v.push(t); v }
    }
  }
};

// `[T: Comparable]` (plan 41's Decision log) — a general comma list at
// the grammar level; the single-type-parameter, bound-mandatory
// restriction is entirely sema's job (`TypeParam`'s own bound is
// mandatory here, but *how many* of them a function may declare is
// not).
TypeParamClause: Vec<TypeParam> = {
  "[" <params:TypeParamList> "]" => params,
};

TypeParamList: Vec<TypeParam> = {
  <p:TypeParam> => vec![p],
  <p:TypeParam> "," <rest:TypeParamList> => {
    let mut v = vec![p];
    v.extend(rest);
    v
  },
};

TypeParam: TypeParam = {
  <name:Ident> ":" <bound:Ident> => TypeParam { name, bound: Some(bound) },
  // Plan 58's Decision log: the bound-less alternative — `class Box[T]`'s
  // own headline case. `TypeParam.bound` widened to `Option<String>`
  // precisely to admit this; sema (not the grammar) still rejects a
  // bound-less type parameter on a top-level generic FUNCTION with its
  // own "generic functions require a bound" diagnostic, unchanged.
  <name:Ident> => TypeParam { name, bound: None },
};

// Plan 40's Decision log: operator-named methods are legal only inside
// a `class ... end` body — `ClassDef`'s own method list is the only
// caller of `MethodDef`/`MethodName`; `FuncDef`/`ModuleDef` keep
// requiring a plain `Ident` name, unchanged. `"<=>"` is a genuinely new
// terminal, added only at this method-*definition* position — no
// `a <=> b` infix expression syntax exists yet (that's plan 41's job).
// `Function.name` needs no new AST shape — it's already a plain
// `String`.
MethodName: String = {
  <n:Ident> => n,
  "+" => "+".to_string(),
  "-" => "-".to_string(),
  "*" => "*".to_string(),
  "/" => "/".to_string(),
  "==" => "==".to_string(),
  "<=>" => "<=>".to_string(),
  "[" "]" => "[]".to_string(),
  "[" "]" "=" => "[]=".to_string(),
};

MethodDef: Function = {
  // Plan 41's Decision log: `[T: Bound]` is grammatically reachable
  // here too (a class method), even though only a *top-level* function's
  // `type_params` is ever accepted — sema rejects a non-empty
  // `type_params` found while registering a class method with a real
  // "generic methods are not supported" diagnostic, never a panic and
  // never a silent accept.
  <is_pure:"pure"?> <comptime:"comptime"?> "def" <name:MethodName> <type_params:TypeParamClause?> <parts:ParenParams> "->" <return_type:TypeName> <body:Stmt*> "end" => Function {
    name,
    params: parts.0,
    return_type,
    body,
    block_param: parts.2,
    splat_param: parts.1,
    type_params: type_params.unwrap_or_default(),
    is_comptime: comptime.is_some(),
    // Plan 62's Decision log: `requires`/`ensures` are grammatically
    // unreachable on a method at all — no `ContractClause*` slot exists
    // in this production, a stricter cut than `type_params`'s own
    // "reachable, sema-rejected" precedent.
    requires: Vec::new(),
    ensures: Vec::new(),
    // Plan 63's Decision log: `pure` IS grammatically reachable here
    // (a class/actor method) — sema's whole-call-graph purity checker
    // is what rejects it specifically on an actor method, the same
    // "grammar stays general, sema narrows" cut `type_params` uses.
    is_pure: is_pure.is_some(),
  }
};

// Parens are optional for zero-arg methods (`def sum -> Float64`,
// inception §17's Point example) — Ruby allows omitting an empty
// parameter list entirely. Plan 34: an optional trailing `&blk` marker
// (`def repeat(n: Int64, &blk)`) — NOT a separate `"," "&" Ident`
// alternative, since `FuncParams`'s own comma-list already eagerly
// consumes a trailing comma whenever the token after it can't start
// another parameter (the same "stop the repetition, don't shift the
// comma into a phantom next iteration" behavior every trailing-comma-
// list use in this grammar already relies on) — by the time
// `FuncParams` reduces, any `n: Int64,` prefix has already swallowed
// its own comma, leaving a bare `&blk` (no comma) for this rule to
// match directly. Plan 39: `FuncParams` (function-only — `ParenParams`
// is the only caller) replaces the shared `Params`/`Param` this rule
// used before, so a `def` parameter list alone can carry defaults/a
// trailing splat; `ClassField`/lambda/block parameter lists keep using
// the original, untouched `Params`/`Param`.
ParenParams: (Vec<Param>, Option<Param>, Option<String>) = {
  "(" <parts:FuncParams> "&" <blk:Ident> ")" => (parts.0, parts.1, Some(blk)),
  "(" <parts:FuncParams> ")" => (parts.0, parts.1, None),
  => (Vec::new(), None, None),
};

// Plan 39's Decision log: ordinary/defaulted parameters, then an
// optional trailing splat — never interleaved (a splat, if present, is
// always this list's last element). Right-recursive, mirroring every
// other comma-list in this grammar (`CaseValues`, `YieldArgs`, ...).
FuncParams: (Vec<Param>, Option<Param>) = {
  => (Vec::new(), None),
  <p:SplatParam> => (Vec::new(), Some(p)),
  <p:FuncParam> => (vec![p], None),
  <p:FuncParam> "," <rest:FuncParams> => {
    let mut v = vec![p];
    v.extend(rest.0);
    (v, rest.1)
  },
};

FuncParam: Param = {
  <name:Ident> ":" <ty:TypeName> => Param { name, ty, default: None },
  // Plan 39's Decision log: `DefaultLit` admits only literal tokens —
  // never an `Expr::Ident` — so `def f(x: Int64, y: Int64 = x)` (a
  // default referencing another parameter) is a parse error here, at
  // the grammar level, not a sema diagnostic.
  <name:Ident> ":" <ty:TypeName> "=" <d:DefaultLit> => Param { name, ty, default: Some(d) },
};

DefaultLit: Spanned<Expr> = {
  <l:@L> <n:Num> <r:@R> => Spanned { span: (l, r), node: Expr::Int(n) },
  <l:@L> <f:FloatLit> <r:@R> => Spanned { span: (l, r), node: Expr::Float(f) },
  <l:@L> <s:StringLitTok> <r:@R> => Spanned { span: (l, r), node: Expr::StringLit(decode_string_lit(&s)) },
  <l:@L> "true" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(true) },
  <l:@L> "false" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(false) },
  <l:@L> "nil" <r:@R> => Spanned { span: (l, r), node: Expr::Nil },
};

SplatParam: Param = {
  "*" <name:Ident> ":" <ty:TypeName> => Param { name, ty, default: None },
};

// Plan 39: a mandatory-first-element, right-recursive `name: Expr` list
// (mirrors `CaseValues`/`YieldArgs`) — at least one keyword argument,
// since a zero-argument call already parses via the ordinary `Args`
// path (`Expr::Call`), never this one.
CallKwArgs: Vec<(String, Spanned<Expr>)> = {
  <n:Ident> ":" <e:Expr> => vec![(n, e)],
  <n:Ident> ":" <e:Expr> "," <rest:CallKwArgs> => {
    let mut v = vec![(n, e)];
    v.extend(rest);
    v
  },
};

// `puts` is a reserved keyword, not a generic identifier — see plan 07's
// Decision log. A general "Ident followed by an expression" command-call
// rule alongside a general "bare Expr statement" rule is a genuine
// LALR(1) shift/reduce conflict when both start with Ident; reserving the
// one builtin this compiler has sidesteps it entirely.
// Plan 22's Decision log: every alternative below captures its own
// `<l:@L> ... <r:@R>` and wraps its `Stmt::Variant{...}` result in
// `Spanned { span: (l, r), node: ... }` — the statement's span always
// covers the whole statement (keyword through terminator), the honest
// fallback described in the Decision log for statements with no
// better sub-expression to blame more precisely (`break`/`next`/
// `retry` in particular). A desugared sub-expression an action
// synthesizes itself (`unless`'s `Expr::Not`, a compound assignment's
// `Expr::Add`/etc.) reuses this same outer `(l, r)` span — there's no
// real source text for just the synthesized node to point at instead.
Stmt: Spanned<Stmt> = {
  <l:@L> <name:Ident> ":" <ty:TypeName> "=" <value:Expr> <r:@R> => Spanned { span: (l, r), node: Stmt::Let { name, ty, value } },
  <l:@L> "if" <cond:Expr> <then_branch:Stmt*> <else_branch:ElseClause?> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::If { cond, then_branch, else_branch } },
  <l:@L> "while" <cond:Expr> <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::While { cond, body } },
  // Plan 29: pure parse-time desugaring — no new AST shape, just the
  // condition wrapped in plan 18's `Expr::Not` (see the Decision log).
  // Reuses `ElseClause` as-is, so `unless ... else ... end` falls out
  // for free.
  <l:@L> "unless" <cond:Expr> <then_branch:Stmt*> <else_branch:ElseClause?> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::If {
    cond: Spanned { span: (l, r), node: Expr::Not(Box::new(cond)) },
    then_branch,
    else_branch,
  }},
  <l:@L> "until" <cond:Expr> <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::While {
    cond: Spanned { span: (l, r), node: Expr::Not(Box::new(cond)) },
    body,
  }},
  // Plan 30: deliberately mirrors `PrimaryExpr`'s own `"[" Args "]"`
  // array-literal shape rather than accepting an arbitrary `Expr`
  // scrutinee, so `for x in arr` (a bare identifier) is a parse error,
  // not deferred to sema — see the Decision log's scope cut.
  <l:@L> "for" <var:Ident> "in" "[" <elements:Args> "]" <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::For {
    var,
    elements,
    body,
  }},
  // Plan 37: no first-class `Range` value — `..`/`...` are grammar-
  // restricted to appear only directly after a `for <var> in`
  // scrutinee, mirroring plan 30's own array-literal-only restriction
  // immediately above. LALRPOP's literal-terminal tokenizer resolves
  // `"..."` vs `".."` vs the pre-existing single `"."` token by
  // longest-match, so no `match {}` priority reordering is needed.
  <l:@L> "for" <var:Ident> "in" <start:Expr> ".." <end:Expr> <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::ForRange {
    var,
    start,
    end,
    exclusive: false,
    body,
  }},
  <l:@L> "for" <var:Ident> "in" <start:Expr> "..." <end:Expr> <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::ForRange {
    var,
    start,
    end,
    exclusive: true,
    body,
  }},
  // Requires a value (no bare `return;`) — `<e:Expr?>` here is genuinely
  // LALR(1)-ambiguous: with no significant newlines (plan 04's
  // simplification), the parser can't tell "return" (empty, followed by a
  // new Expr-statement) from "return <expr>" (one statement) when the
  // next token can start an Expr either way. Bare Void-returning `return`
  // is deferred until source-line significance is added.
  // Plan 39's Decision log: generalizes the single-`Expr` `return` into
  // an optional comma list the same mechanical way `YieldArgs` already
  // does — `Stmt::Return(Some(e))` unchanged for a single element,
  // `Stmt::Return(Some(Expr::TupleLit(es)))` for more than one. Reuses
  // `YieldArgs` for the tail list rather than a second near-identical
  // nonterminal — it's already exactly "one or more comma-separated
  // `Expr`s," with no `yield`-specific meaning baked in.
  <l:@L> "return" <e:Expr> <r:@R> => Spanned { span: (l, r), node: Stmt::Return(Some(e)) },
  <l:@L> "return" <first:Expr> "," <rest:YieldArgs> <r:@R> => {
    let mut v = vec![first];
    v.extend(rest);
    Spanned { span: (l, r), node: Stmt::Return(Some(Spanned { span: (l, r), node: Expr::TupleLit(v) })) }
  },
  <l:@L> "break" <r:@R> => Spanned { span: (l, r), node: Stmt::Break },
  <l:@L> "next" <r:@R> => Spanned { span: (l, r), node: Stmt::Next },
  <l:@L> "puts" <arg:Expr> <r:@R> => Spanned { span: (l, r), node: Stmt::Expr(Spanned { span: (l, r), node: Expr::Call("puts".to_string(), vec![arg]) }) },
  // Same "always requires a value" shape as `return` above, same reason
  // (no bare `<e:Expr?>` — genuinely LALR(1)-ambiguous with no
  // significant newlines).
  <l:@L> "raise" <e:Expr> <r:@R> => Spanned { span: (l, r), node: Stmt::Raise(e) },
  // Plan 34: `yield <args>` — legal only inside a function declaring
  // `Function.block_param` (sema's job, not the grammar's). Uses
  // `YieldArgs`, NOT the ordinary `Args` (which can derive zero
  // elements) — the same "always requires something, no ambiguous
  // optional" reasoning as `return`/`raise`/`puts` above: with no
  // significant newlines, `"yield" <e:Expr?>`-shaped zero-or-more args
  // would make the parser unable to tell "yield" (empty) followed by a
  // fresh Expr-statement from "yield <expr>" whenever the next token
  // can start an Expr either way — a real, disclosed narrowing versus
  // Ruby's own bare zero-arg `yield`, not attempted here.
  <l:@L> "yield" <args:YieldArgs> <r:@R> => Spanned { span: (l, r), node: Stmt::Yield(args) },
  // Plan 38: one or more `rescue` clauses (subtype-aware matching,
  // source order — sema/codegen's job, not the grammar's), an optional
  // trailing `ensure`. `"rescue"`/`"ensure"` can't start a `Stmt`, so
  // `body`'s `Stmt*` unambiguously stops at the next `"rescue"`, the
  // same way `"end"`/`"else"` already terminate other `Stmt*` blocks.
  <l:@L> "begin" <body:Stmt*> <rescues:RescueClause+> <ensure:EnsureClause?> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::Begin {
    body,
    rescues,
    ensure,
  }},
  // Plan 38: legal only inside a `rescue` clause's own body — sema's
  // job, not the grammar's, exactly like `break`/`next`'s in-loop
  // restriction.
  <l:@L> "retry" <r:@R> => Spanned { span: (l, r), node: Stmt::Retry },
  // Plan 20: value-match, not `spec/GRAMMAR.md`'s eventual `===`
  // dispatch (see the Decision log). `"when"` can't start a `Stmt`, so
  // `CaseArm`'s own trailing `Stmt*` unambiguously stops at the next
  // `"when"`/`"else"`/`"end"`, the same way `"rescue"` already
  // terminates `begin`'s body above.
  <l:@L> "case" <scrutinee:Expr> <arms:CaseArm+> <else_body:ElseClause?> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::Case {
    scrutinee,
    arms,
    else_body,
  }},
  // Plan 53's Decision log: a small, dedicated `Result[T, E]`
  // destructuring form, deliberately independent of plan 52's
  // `CaseArm`/`CasePattern` mechanism above — disambiguated from it by
  // the very next token after `"when"` (`"Ok"`/`"Err"` are reserved-
  // keyword terminals, categorically distinct from both `Num`
  // (`CaseValues`) and `Ident` (plan 52's `Variant` pattern), so there
  // is no FIRST-set overlap to resolve). Both arms mandatory, fixed
  // order, no `else`.
  <l:@L> "case" <scrutinee:Expr> "when" "Ok" "(" <ok_var:Ident> ")" <ok_body:Stmt*> "when" "Err" "(" <err_var:Ident> ")" <err_body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Stmt::MatchResult {
    scrutinee,
    ok_var,
    ok_body,
    err_var,
    err_body,
  }},
  // Assignment to an instance variable (`@x = value`), an array index
  // (`arr[i] = value`), or a plain local (`x = value`, plan 31's
  // Decision log). All three are just `Expr` on the left — `CallExpr`'s
  // left-recursive indexing rule (below) already parses `arr[i]`
  // unambiguously, so re-deriving a *separate* `Ident "[" Expr "]"`
  // grammar production here (plan 09's first attempt) would compete with
  // it for the same lookahead and is a genuine LALR(1) conflict.
  // Accepting a general `Expr` on the left and checking its shape in the
  // action (`=>?`, a real parse error on an invalid target — not a
  // panic) is the standard fix.
  <l:@L> <lhs:StmtExpr> "=" <value:Expr> <r:@R> =>? match lhs.node {
    Expr::InstanceVar(name) => Ok(Spanned { span: (l, r), node: Stmt::SetField { name, value } }),
    Expr::Index(array, index) => Ok(Spanned { span: (l, r), node: Stmt::SetIndex { array: *array, index: *index, value } }),
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { name, value } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid assignment target: {other:?}"),
    }),
  },
  // Plan 31: `x += 1` desugars at parse time into `Stmt::Assign { name,
  // value: Expr::Add(Ident(name), rhs) }` — per `spec/GRAMMAR.md` §3's
  // own description of compound assignment as sugar over `x = x + 1`.
  // Restricted to a plain local target (`Expr::Ident`) only — unlike the
  // plain `"="` rule above, compound assignment doesn't extend to
  // `@field`/`arr[i]` targets (Decision log: `Stmt::Assign`'s `name` is
  // a flat `String`, not a general assignable `Expr`).
  <l:@L> <lhs:StmtExpr> "+=" <rhs:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { value: Spanned { span: (l, r), node: Expr::Add(Box::new(Spanned::synthetic(Expr::Ident(name.clone()))), Box::new(rhs)) }, name } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  <l:@L> <lhs:StmtExpr> "-=" <rhs:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { value: Spanned { span: (l, r), node: Expr::Sub(Box::new(Spanned::synthetic(Expr::Ident(name.clone()))), Box::new(rhs)) }, name } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  <l:@L> <lhs:StmtExpr> "*=" <rhs:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { value: Spanned { span: (l, r), node: Expr::Mul(Box::new(Spanned::synthetic(Expr::Ident(name.clone()))), Box::new(rhs)) }, name } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  <l:@L> <lhs:StmtExpr> "/=" <rhs:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { value: Spanned { span: (l, r), node: Expr::Div(Box::new(Spanned::synthetic(Expr::Ident(name.clone()))), Box::new(rhs)) }, name } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  <l:@L> <lhs:StmtExpr> "%=" <rhs:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::Assign { value: Spanned { span: (l, r), node: Expr::Rem(Box::new(Spanned::synthetic(Expr::Ident(name.clone()))), Box::new(rhs)) }, name } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  // Plan 43's Decision log: genuinely conditional, unlike `+=`/etc.
  // above — NOT desugared into `Stmt::Assign` (`x = x + 1`'s rewrite
  // works because `+` is unconditionally evaluated either way; `||=`/
  // `&&=` are not). Same plain-local-target restriction as every
  // compound-assignment form above.
  <l:@L> <lhs:StmtExpr> "||=" <default:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::OrAssign { name, default } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  <l:@L> <lhs:StmtExpr> "&&=" <value:Expr> <r:@R> =>? match lhs.node {
    Expr::Ident(name) => Ok(Spanned { span: (l, r), node: Stmt::AndAssign { name, value } }),
    other => Err(lalrpop_util::ParseError::User {
      error: format!("invalid compound-assignment target: {other:?}"),
    }),
  },
  // Plan 31: fixed-arity multiple assignment (`a, b = b, a`) — a raw,
  // right-recursive `Ident`/`Expr` list (not routed through `StmtExpr`,
  // unlike every rule above), since the deciding factor between this
  // and an ordinary Stmt-initial expression is the very next token
  // after the first `Ident`: a literal `,` here never follows a bare
  // `StmtExpr` in any other Stmt-initial context in this grammar, so
  // there's no existing FOLLOW-set overlap this collides with (same
  // reasoning as plan 20's `CaseValues` right-recursion).
  <l:@L> <names:MultiAssignNames> "=" <values:MultiAssignValues> <r:@R> => Spanned { span: (l, r), node: Stmt::MultiAssign { names, values } },
  // Plan 39's Decision log: `x, y = f()` — a single call-shaped RHS
  // whose declared return type is a tuple — needs the multi-assign
  // Stmt to admit exactly one value too, not just `MultiAssignValues`'
  // existing two-or-more shape. A dedicated sibling alternative here
  // (rather than adding a single-`Expr` case to `MultiAssignValues`
  // itself) avoids a genuine LALR(1) shift/reduce conflict on `,`
  // between "reduce as the one-and-only value" and "shift `,`, this is
  // the first of two-or-more" that a shared nonterminal would create.
  // Sema's `check_multi_assign` is what actually validates this single
  // value (tuple-returning call vs. a real arity-mismatch diagnostic
  // for anything else) — the grammar just needs to stop rejecting the
  // shape outright.
  <l:@L> <names:MultiAssignNames> "=" <value:Expr> <r:@R> => Spanned { span: (l, r), node: Stmt::MultiAssign { names, values: vec![value] } },
  <l:@L> <e:StmtExpr> <r:@R> => Spanned { span: (l, r), node: Stmt::Expr(e) },
};

// Plan 34: mandatory-first-element, right-recursive — mirrors
// `CaseValues`/`MultiAssignNames`'s own trick for the identical reason
// (see `Stmt`'s `"yield" <args:YieldArgs>` comment).
YieldArgs: Vec<Spanned<Expr>> = {
  <e:Expr> => vec![e],
  <e:Expr> "," <rest:YieldArgs> => {
    let mut v = vec![e];
    v.extend(rest);
    v
  },
};

MultiAssignNames: Vec<String> = {
  <first:Ident> "," <last:Ident> => vec![first, last],
  <first:Ident> "," <rest:MultiAssignNames> => {
    let mut v = vec![first];
    v.extend(rest);
    v
  },
};

MultiAssignValues: Vec<Spanned<Expr>> = {
  <first:Expr> "," <last:Expr> => vec![first, last],
  <first:Expr> "," <rest:MultiAssignValues> => {
    let mut v = vec![first];
    v.extend(rest);
    v
  },
};

// A restricted mirror of `Expr`/`AddExpr`/`CallExpr` used *only* for the
// two Stmt-initial positions above (the bare-expression statement, and an
// assignment's LHS). It's identical except its base case drops
// `PrimaryExpr`'s bare `"[" Args "]"` (array-literal) alternative.
//
// Without this split, `[` ends up in FIRST(Stmt) — reachable via a bare
// array-literal statement — which in turn puts `[` in FOLLOW(CallExpr),
// directly colliding with `CallExpr`'s own left-recursive indexing shift
// (`CallExpr "[" Expr "]"`): after building a `CallExpr`, seeing `[` next
// is genuinely ambiguous between "keep indexing" and "finish this
// statement, a new one starting with an array literal begins here" —
// there are no statement separators (newlines are insignificant, plan
// 04) to break the tie. A bare array literal has no side effects, so
// forbidding it as a *standalone* statement (it's still fully usable as
// a Let/assignment/Return value, an Args element, etc. — anywhere it
// isn't the first token of a fresh Stmt) costs nothing real.
// Plan 18's precedence ladder, mirrored on the Stmt-initial side exactly
// like the pre-existing `StmtAddExpr`/`StmtCallExpr` split: only the
// leftmost (base-case) position of each tier stays `Stmt`-restricted —
// every operator's right-hand operand uses the ordinary (non-`Stmt`)
// tier below it, since by the time the parser is past the operator
// token it's no longer at a Stmt-initial position and the array-literal
// ambiguity this split exists to avoid can't recur.
StmtExpr: Spanned<Expr> = {
  StmtOrExpr,
};

StmtOrExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtOrExpr> "||" <rhs:AndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Or(Box::new(lhs), Box::new(rhs)) },
  StmtAndExpr,
};

StmtAndExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtAndExpr> "&&" <rhs:CompareExpr> <r:@R> => Spanned { span: (l, r), node: Expr::And(Box::new(lhs), Box::new(rhs)) },
  StmtCompareExpr,
};

// Plan 28: mirrors `BitOrExpr`/`BitAndExpr`/`ShiftExpr` below, one tier
// each, for the same Stmt-initial reason every other tier here is
// mirrored (see the block comment above `StmtExpr`).
StmtCompareExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtBitOrExpr> <op:CompareOp> <rhs:BitOrExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Compare(Box::new(lhs), op, Box::new(rhs)) },
  StmtBitOrExpr,
};

StmtBitOrExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtBitOrExpr> "|" <rhs:BitAndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitOr(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:StmtBitOrExpr> "^" <rhs:BitAndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitXor(Box::new(lhs), Box::new(rhs)) },
  StmtBitAndExpr,
};

StmtBitAndExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtBitAndExpr> "&" <rhs:ShiftExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitAnd(Box::new(lhs), Box::new(rhs)) },
  StmtShiftExpr,
};

StmtShiftExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtShiftExpr> "<<" <rhs:AddExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Shl(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:StmtShiftExpr> ">>" <rhs:AddExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Shr(Box::new(lhs), Box::new(rhs)) },
  StmtAddExpr,
};

StmtAddExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtAddExpr> "+" <rhs:MulExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Add(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:StmtAddExpr> "-" <rhs:MulExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Sub(Box::new(lhs), Box::new(rhs)) },
  StmtMulExpr,
};

StmtMulExpr: Spanned<Expr> = {
  <l:@L> <lhs:StmtMulExpr> "*" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Mul(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:StmtMulExpr> "/" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Div(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:StmtMulExpr> "%" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Rem(Box::new(lhs), Box::new(rhs)) },
  StmtUnaryExpr,
};

// Unlike `Expr`'s `UnaryExpr`, this mirror has no prefix `-`/`!`
// alternative — the same "forbid it only at Stmt-initial position" fix
// plan 09 used for bare array literals. A standalone `-x`/`!x` statement
// (no assignment, no call) is side-effect-free and useless either way,
// but *allowing* it here would put `-`/`!` in FIRST(Stmt) — reachable as
// the first token of a fresh statement right after a completed one —
// which collides with `StmtAddExpr`/`StmtMulExpr`'s own binary `-`
// continuation: LALR(1) can't tell "shift `-` to keep extending the
// current expression" from "reduce, a new statement starting with
// unary `-` begins here" using one token of lookahead once both are
// reachable from the same state. Unary `-`/`!` remain fully available
// everywhere else (Let's RHS, a call argument, nested inside a binary
// operator's operand) via the ordinary, non-`Stmt` `UnaryExpr`.
// Plan 61's Decision log: `comptime` joins this mirror too, unlike `-`/
// `!` above it — safe here for a genuinely different reason than why
// they're excluded. `-`/`!` are excluded because they ALSO serve as
// binary-continuation tokens at this same Stmt tier (`StmtAddExpr`'s own
// "-", `StmtCompareExpr`'s own operators use "!="), so a fresh statement
// beginning with one collides with "keep extending the previous
// statement's expression" in the parser state reachable right after a
// completed statement. `"comptime"` is a single-purpose reserved keyword
// with no such double duty — nothing else in this grammar's FOLLOW(Stmt)
// position is spelled `"comptime"` — so adding it here is conflict-free
// the same way adding it to `UnaryExpr` above already proved to be.
StmtUnaryExpr: Spanned<Expr> = {
  <l:@L> "comptime" <e:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Comptime(Box::new(e)) },
  StmtCallExpr,
};

StmtCallExpr: Spanned<Expr> = {
  <l:@L> <base:StmtCallExpr> "[" <idx:Expr> "]" <r:@R> => Spanned { span: (l, r), node: Expr::Index(Box::new(base), Box::new(idx)) },
  <l:@L> <base:StmtCallExpr> "?" <r:@R> => Spanned { span: (l, r), node: Expr::Try(Box::new(base)) },
  StmtPrimaryExpr,
};

// Plan 45's Decision log: `.read` (`File.read`) needs this — plan 33's
// class-field sugar (`"read" <p:Param>`) already reserved `read` as a
// distinct terminal, globally, everywhere in this grammar (LALRPOP's
// tokenizer is context-free), so a bare `<method:CallMethodName>` slot can never
// match it. Widens exactly the method-name position in `.method(args)`/
// `.method`/`&.method(args)`/`&.method` — mirrors plan 40's `MethodName`
// widening for class-method *definitions*, applied here to call
// *sites* instead.
CallMethodName: String = {
  <n:Ident> => n,
  "read" => "read".to_string(),
};

// Plan 22's Decision log: an implicit bare-`Ident` receiver
// (`Expr::Ident(recv)` inside a `.method`/`&.method` alternative below)
// is a synthesized node with no real source span of its own to point
// at more precisely than the whole call — `Spanned::synthetic` marks
// that honestly rather than fabricating one.
StmtPrimaryExpr: Spanned<Expr> = {
  <l:@L> <name:Ident> "(" <mut args:Args> ")" <blk:BlockLiteral?> <r:@R> => {
    if let Some(b) = blk { args.push(b); }
    Spanned { span: (l, r), node: Expr::Call(name, args) }
  },
  // Plan 39's Decision log: see `PrimaryExpr`'s own mirror alternative.
  <l:@L> <name:Ident> "(" <kwargs:CallKwArgs> ")" <r:@R> => Spanned { span: (l, r), node: Expr::CallKw(name, kwargs) },
  <l:@L> <recv:Ident> "." "new" "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::New(recv, args) },
  // Plan 54's Decision log: deliberately distinct from `.new` above —
  // `spawn` is a new reserved keyword for the same LALR(1) reason `new`
  // already is, so `Counter.new(0)`/`AnyClass.spawn(0)` are both real,
  // symmetric, textually-disjoint call forms (sema decides which
  // receivers are actually valid for each, not the grammar).
  <l:@L> <recv:Ident> "." "spawn" "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Spawn(recv, args) },
  // Plan 60's Decision log: `.spawn`'s distributed counterpart — the
  // identical reserved-keyword-headed shape, `remote` reserved the same
  // LALR(1) way `spawn` already is.
  <l:@L> <class:Ident> "." "remote" "(" <addr:Expr> "," <name:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Remote { class, addr: Box::new(addr), name: Box::new(name) } },
  <l:@L> "Array" "." "new" "(" <size:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::ArrayNew(Box::new(size)) },
  // Plan 53's Decision log: `Ok`/`Err` are literal-keyword-headed
  // constructor productions, the same convention `Array`/`Hash`/`Proc`
  // already use — not a general user-extensible mechanism.
  <l:@L> "Ok" "(" <e:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Ok(Box::new(e)) },
  <l:@L> "Err" "(" <e:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Err(Box::new(e)) },
  // Plan 57's Decision log: `"do"` is already a real, distinct
  // terminal (plan 47's own `test "..." do ... end`), so this shares
  // it rather than inventing a second one — no FIRST-set overlap with
  // anything else here, since `"supervise"` alone disambiguates.
  <l:@L> "supervise" "do" <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Expr::Supervise(body) },
  <l:@L> <recv:Ident> "." <method:CallMethodName> "(" <mut args:Args> ")" <blk:BlockLiteral?> <r:@R> => {
    if let Some(b) = blk { args.push(b); }
    Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, args) }
  },
  <l:@L> <recv:Ident> "." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, vec![]) },
  // Plan 55's Decision log: `@field.method(args)` — this plan's own
  // `@peer.hit` cross-actor call shape. Mirrors the two `Ident`-headed
  // `MethodCall` alternatives immediately above exactly, `InstanceVarTok`
  // in place of `Ident` as the receiver token — no FIRST-set overlap to
  // disambiguate, since `@`-prefixed and bare-identifier receivers are
  // already two distinct terminals everywhere else in this grammar
  // (see `InstanceVarTok`'s own bare-expression alternative below).
  // Deliberately narrower than a general "any receiver expression" rule
  // (this crate's own established incremental-scope convention): only
  // `@field.method(...)`, not `@field&.method(...)`/arbitrary nesting —
  // sema/codegen's own real scope for this plan is exactly this one
  // shape.
  <l:@L> <recv:InstanceVarTok> "." <method:CallMethodName> "(" <mut args:Args> ")" <blk:BlockLiteral?> <r:@R> => {
    if let Some(b) = blk { args.push(b); }
    Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::InstanceVar(recv))), method, args) }
  },
  <l:@L> <recv:InstanceVarTok> "." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::InstanceVar(recv))), method, vec![]) },
  // Plan 43's Decision log: mirrors the two `MethodCall` alternatives
  // immediately above exactly, `"&."` in place of `"."` — a genuinely
  // new terminal, distinct from `"."`/`"&"` (bitwise/block-param
  // marker)/`"&&"`, so there's no FIRST-set overlap to disambiguate.
  <l:@L> <recv:Ident> "&." <method:CallMethodName> "(" <args:Args> ")" <r:@R> => {
    Spanned { span: (l, r), node: Expr::SafeCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, args) }
  },
  <l:@L> <recv:Ident> "&." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::SafeCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, vec![]) },
  // Plan 47's Decision log: `assert`/`assert_eq` need their own
  // productions (not the generic `<name:Ident> "(" <args:Args> ")"`
  // call shape) purely to capture `@L` — LALRPOP's own byte-offset
  // marker, available only in a grammar action, never reconstructable
  // sema/codegen-side. The extra trailing `Expr::Int(l as i64)` is a
  // raw-offset placeholder `parse_named`'s own post-parse pass
  // (`rewrite_assert_locations`) rewrites into a real
  // `Expr::StringLit("{name}:{line}")` before any caller ever sees it.
  <l:@L> "assert" "(" <cond:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Call("assert".to_string(), vec![cond, Spanned::synthetic(Expr::Int(l as i64))]) },
  <l:@L> "assert_eq" "(" <expected:Expr> "," <actual:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Call("assert_eq".to_string(), vec![expected, actual, Spanned::synthetic(Expr::Int(l as i64))]) },
  <l:@L> <f:FloatLit> <r:@R> => Spanned { span: (l, r), node: Expr::Float(f) },
  <l:@L> <n:Num> <r:@R> => Spanned { span: (l, r), node: Expr::Int(n) },
  <l:@L> <s:StringLitTok> <r:@R> =>? interpolate::parse_interpolated_string(&s)
    .map(|node| Spanned { span: (l, r), node })
    .map_err(|error| lalrpop_util::ParseError::User { error }),
  <l:@L> <s:SymbolLitTok> <r:@R> => Spanned { span: (l, r), node: Expr::SymbolLit(s) },
  <l:@L> "true" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(true) },
  <l:@L> "false" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(false) },
  <l:@L> "nil" <r:@R> => Spanned { span: (l, r), node: Expr::Nil },
  // Plan 34: `HashLit`'s bare `"{" HashPairs "}"` alternative is
  // deliberately DROPPED from this Stmt-initial position (unlike
  // `PrimaryExpr`, which keeps it) — a real, build-verified LALR(1)
  // conflict, not a hypothetical one: with a trailing `BlockLiteral?`
  // now attached to the two call productions above, `{` right after a
  // completed call is genuinely ambiguous between "attach a block" and
  // "reduce, a fresh bare hash-literal statement begins here," the same
  // class of conflict plan 09 already hit and fixed for array literals
  // at this exact position ("forbidding it as a *standalone* statement
  // costs nothing real" — a bare hash-literal statement is equally
  // side-effect-free and useless). `HashLit` remains fully available
  // everywhere else (a `Let`'s RHS, a call argument) via the ordinary,
  // non-`Stmt` `PrimaryExpr`.
  <l:@L> <name:InstanceVarTok> <r:@R> => Spanned { span: (l, r), node: Expr::InstanceVar(name) },
  <l:@L> <name:Ident> <r:@R> => Spanned { span: (l, r), node: Expr::Ident(name) },
};

// Plan 34: `{ |params| body }` — a trailing block literal, desugared to
// `Expr::Lambda` (reusing plan 10's node wholesale — see the Decision
// log) and pushed as an extra, implicit trailing argument onto the
// call it attaches to. Always `Void`-returning (no `-> Type>` — real
// Ruby block syntax has none either, and this plan's blocks are never
// value-producing).
BlockLiteral: Spanned<Expr> = {
  <l:@L> "{" "|" <params:Params> "|" <body:Stmt*> "}" <r:@R> => Spanned { span: (l, r), node: Expr::Lambda {
    params,
    return_type: "Void".to_string(),
    body,
  }},
};

// Plan 25: `{k1 => v1, k2 => v2, ...}` — reuses `"=>"` (already a
// terminal, from `rescue Type => e`). Always closed by a known `"}"`
// right after (like `Args`' own `)`/`]` delimiters), so the ordinary
// left-recursive-with-trailing-optional shape is safe here — no
// `CaseValues`-style ambiguity, since nothing after `HashPairs` is ever
// `Stmt*`. Zero pairs (`{}`) is grammar-legal; sema rejects it (same
// "no element type to infer" reasoning plan 09 already applies to `[]`).
HashPairs: Vec<(Spanned<Expr>, Spanned<Expr>)> = {
  <mut v:(<HashPair> ",")*> <last:HashPair?> => {
    match last {
      None => v,
      Some(p) => { v.push(p); v }
    }
  }
};

HashPair: (Spanned<Expr>, Spanned<Expr>) = {
  <k:Expr> "=>" <v:Expr> => (k, v)
};

ElseClause: Vec<Spanned<Stmt>> = {
  "else" <body:Stmt*> => body,
  // Plan 29: an `elsif` chain is a real, correctly-nested `Stmt::If`
  // sequence — one single-element `Vec<Stmt>` per link, wrapping the
  // rest of the chain (another `elsif`, a trailing `else`, or nothing)
  // as this nested `If`'s own `else_branch`. No new AST variant; see
  // the Decision log.
  <l:@L> "elsif" <cond:Expr> <then_branch:Stmt*> <rest:ElseClause?> <r:@R> => vec![Spanned { span: (l, r), node: Stmt::If {
    cond,
    then_branch,
    else_branch: rest,
  }}],
};

// Plan 20: `when v1, v2, ... body`. NOT `Args` (the existing
// left-recursive-with-optional-trailing-item comma list) — `Args` is
// only ever followed by a known, Expr-disjoint delimiter (`)`/`]`)
// everywhere else it's used, so LALR(1) can cleanly decide "reduce,
// the list is done" the moment it sees that delimiter. Here the list
// is followed by `Stmt*`, whose FIRST set overlaps `Expr`'s (a bare
// `when 1, 2\n  3\nend` — the second `2`, or a nonsensical trailing
// `3`, could ambiguously be "one more when-value" or "the body's
// first, uselessly bare, statement"), a real conflict LALRPOP reported.
// Right recursion sidesteps it: the only decision after a value is
// "is the very next token a literal `,`" — never ambiguous with
// `Stmt*`'s FIRST set, since no `Stmt` can start with `,`.
CaseValues: Vec<Spanned<Expr>> = {
  <l:@L> <n:Num> <r:@R> => vec![Spanned { span: (l, r), node: Expr::Int(n) }],
  <l:@L> <n:Num> <r:@R> "," <rest:CaseValues> => {
    let mut v = vec![Spanned { span: (l, r), node: Expr::Int(n) }];
    v.extend(rest);
    v
  },
};

// Plan 52's Decision log: the `Variant` alternative is disambiguated
// from the pre-existing `CaseValues` alternative by the very first
// token after `"when"` (`Num` vs. `Ident`) — no FIRST-set overlap.
CaseArm: CaseArm = {
  "when" <values:CaseValues> <body:Stmt*> => (CasePattern::Values(values), body),
  "when" <name:Ident> "(" <bindings:BindingNames> ")" <body:Stmt*> => {
    (CasePattern::Variant { name, bindings }, body)
  },
};

// Left-recursive, trailing-comma list of plain `Ident`s — a pattern
// binding is never itself a nested pattern (Decision log). Safe left
// recursion, always closed by a known `")"`.
BindingNames: Vec<String> = {
  <mut v:(<Ident> ",")*> <last:Ident?> => {
    match last {
      None => v,
      Some(n) => { v.push(n); v }
    }
  }
};

// Plan 38: a typed clause binds `var` at `class_name`'s type; a bare
// clause (no `class_name`) matches unconditionally and never binds
// `var` in `env` at all (Decision log — no universal root class exists
// to type it at).
RescueClause: RescueClause = {
  "rescue" <c:Ident> "=>" <v:Ident> <b:Stmt*> => RescueClause {
    class_name: Some(c),
    var: v,
    body: b,
  },
  "rescue" "=>" <v:Ident> <b:Stmt*> => RescueClause {
    class_name: None,
    var: v,
    body: b,
  },
};

EnsureClause: Vec<Spanned<Stmt>> = {
  "ensure" <b:Stmt*> => b,
};

// Plan 18's precedence ladder, loosest to tightest: `||` -> `&&` ->
// comparison (unchanged, still non-associative — no `a > b > c`) ->
// `+`/`-` -> `*`/`/`/`%` -> prefix `-`/`!` (right-assoc via
// self-recursion) -> `CallExpr`/`PrimaryExpr` (unchanged). Comparison
// keeps sitting between `&&` and `+`/`-` rather than at the very top —
// `spec/GRAMMAR.md` §4's aspirational full Ruby table has `&&`/`||`
// looser than comparison, which this matches.
// Plan 36: `pub` — a second, independent LALRPOP entry point
// (`ExprParser`) alongside the existing `pub Program` (`ProgramParser`)
// this whole grammar has had since plan 01. `crates/emerald-parser/src/
// interpolate.rs` re-enters this exact rule to parse each `#{...}`
// span found inside a string literal — a real, compile-time-only
// re-parse (never a runtime `eval`), reusing the same static grammar
// that parses the rest of the program rather than inventing a second,
// smaller one.
pub Expr: Spanned<Expr> = {
  OrExpr,
};

OrExpr: Spanned<Expr> = {
  <l:@L> <lhs:OrExpr> "||" <rhs:AndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Or(Box::new(lhs), Box::new(rhs)) },
  AndExpr,
};

AndExpr: Spanned<Expr> = {
  <l:@L> <lhs:AndExpr> "&&" <rhs:CompareExpr> <r:@R> => Spanned { span: (l, r), node: Expr::And(Box::new(lhs), Box::new(rhs)) },
  CompareExpr,
};

CompareExpr: Spanned<Expr> = {
  <l:@L> <lhs:BitOrExpr> <op:CompareOp> <rhs:BitOrExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Compare(Box::new(lhs), op, Box::new(rhs)) },
  BitOrExpr,
};

// Plan 28: three new tiers between `AddExpr` and `CompareExpr` — Ruby's
// real precedence table, tightest to loosest, `<<`/`>>` > `&` > `|`/`^`
// (see this plan's Decision log for why `|`/`^` share one tier: Ruby
// really does give them equal precedence, unlike plan 18's relational/
// equality merge, which was a real simplification).
BitOrExpr: Spanned<Expr> = {
  <l:@L> <lhs:BitOrExpr> "|" <rhs:BitAndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitOr(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:BitOrExpr> "^" <rhs:BitAndExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitXor(Box::new(lhs), Box::new(rhs)) },
  BitAndExpr,
};

BitAndExpr: Spanned<Expr> = {
  <l:@L> <lhs:BitAndExpr> "&" <rhs:ShiftExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitAnd(Box::new(lhs), Box::new(rhs)) },
  ShiftExpr,
};

ShiftExpr: Spanned<Expr> = {
  <l:@L> <lhs:ShiftExpr> "<<" <rhs:AddExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Shl(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:ShiftExpr> ">>" <rhs:AddExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Shr(Box::new(lhs), Box::new(rhs)) },
  AddExpr,
};

CompareOp: CompareOp = {
  ">" => CompareOp::Gt,
  "<" => CompareOp::Lt,
  ">=" => CompareOp::Ge,
  "<=" => CompareOp::Le,
  "==" => CompareOp::Eq,
  "!=" => CompareOp::Ne,
};

AddExpr: Spanned<Expr> = {
  <l:@L> <lhs:AddExpr> "+" <rhs:MulExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Add(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:AddExpr> "-" <rhs:MulExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Sub(Box::new(lhs), Box::new(rhs)) },
  MulExpr,
};

MulExpr: Spanned<Expr> = {
  <l:@L> <lhs:MulExpr> "*" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Mul(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:MulExpr> "/" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Div(Box::new(lhs), Box::new(rhs)) },
  <l:@L> <lhs:MulExpr> "%" <rhs:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Rem(Box::new(lhs), Box::new(rhs)) },
  UnaryExpr,
};

// Tightest binding, right-associative via self-recursion on the operand
// (`--x` parses as `Neg(Neg(x))`, not that this language has any use for
// it) — sits directly above `CallExpr`, so `-a.b`/`-a(1)`/`-a[0]` all
// negate the *result* of the postfix chain, not just `a`.
UnaryExpr: Spanned<Expr> = {
  <l:@L> "-" <e:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Neg(Box::new(e)) },
  <l:@L> "!" <e:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Not(Box::new(e)) },
  // Plan 28: `~` joins `-`/`!` at this tier, additively — same shape,
  // no restructuring (see the Decision log).
  <l:@L> "~" <e:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::BitNot(Box::new(e)) },
  // Plan 61's Decision log: `comptime` joins `-`/`!`/`~` at this exact
  // tier — a real, disclosed, build-verified-necessary placement, not
  // the task brief's own literal `"comptime" <e:Expr>` snippet (an
  // un-delimited prefix keyword whose operand can itself be extended by
  // a trailing binary operator or postfix `[...]`/`?` is genuinely
  // ambiguous either way: at `Expr` tier, `comptime a + b` admits both
  // `Add(Comptime(a), b)` and `Comptime(Add(a, b))`; even down at
  // `PrimaryExpr` tier — this plan's first attempt — `comptime a[0]`
  // still admits both `Index(Comptime(a), 0)` and `Comptime(Index(a,
  // 0))`, since a `PrimaryExpr`-tier result feeds back into `CallExpr`'s
  // own postfix continuation. `UnaryExpr` is the one tier whose result
  // is never re-fed into `CallExpr`'s postfix rules — exactly why `-`/
  // `!`/`~` already live here and nowhere lower). `emerald-sema` narrows
  // this further to exactly two legal *positions* (see `leaf-comptime-
  // const-context-integration`); neither of this plan's own worked
  // examples (`comptime factorial(10)`, `Array.new(comptime
  // factorial(5))`) needs anything looser — both operands are plain
  // calls, already reachable via this tier's `CallExpr` fallthrough.
  <l:@L> "comptime" <e:UnaryExpr> <r:@R> => Spanned { span: (l, r), node: Expr::Comptime(Box::new(e)) },
  CallExpr,
};

// Left-recursive postfix indexing (`a[i]`, and — once chained expressions
// exist — `a[i][j]`): the standard LALR technique for "zero or more
// trailing `[Expr]` suffixes on anything that can already be indexed".
// A *dedicated* `Ident "[" Expr "]"` production (plan 09's first attempt,
// named `IndexTarget`) put `[` in FOLLOW(CallExpr) two different ways at
// once — once for that production's own leading `[`, once because an
// array literal (`PrimaryExpr`'s `"[" Args "]"`) can itself start a new
// `Stmt` right after a completed one — which is exactly the shift/reduce
// conflict LALRPOP reported. Routing *all* indexing through this single
// recursive rule means there is only ever one derivation for `arr[i]`.
CallExpr: Spanned<Expr> = {
  <l:@L> <base:CallExpr> "[" <idx:Expr> "]" <r:@R> => Spanned { span: (l, r), node: Expr::Index(Box::new(base), Box::new(idx)) },
  // Plan 53's Decision log: `expr?` parses anywhere an `Expr` can —
  // sema, not the grammar, restricts it to a `Let`/`Assign` value
  // (the same `ArrayNew`-precedent split this compiler already uses
  // for "needs the consumer's expected type" shapes).
  <l:@L> <base:CallExpr> "?" <r:@R> => Spanned { span: (l, r), node: Expr::Try(Box::new(base)) },
  PrimaryExpr,
};

PrimaryExpr: Spanned<Expr> = {
  // Plan 34: unlike `StmtPrimaryExpr` below, this non-Stmt-initial
  // position doesn't gain a trailing `BlockLiteral?` — `PrimaryExpr`
  // still has its own bare `"{" HashPairs "}"` alternative (below), and
  // a real, build-verified LALR(1) conflict (a genuine shift/reduce
  // ambiguity on `{`, not just a theoretical risk — see the Decision
  // log) rules out attaching an optional block here too without
  // removing `HashLit` from this position as well, which isn't a
  // narrowing this plan is willing to make (a bare hash literal in
  // non-Stmt-initial position — a call argument, a `Let`'s RHS — is a
  // real, existing, tested use, unlike a *bare hash-literal statement*,
  // which is genuinely useless the same way a bare array-literal
  // statement already was in plan 09). Block attachment is therefore
  // scoped to `StmtPrimaryExpr` only — exactly what this plan's own
  // worked example (`repeat(3) { ... }` as a bare top-level statement)
  // needs.
  <l:@L> <name:Ident> "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Call(name, args) },
  // Plan 39's Decision log: keyword-argument calls are scoped to plain
  // function calls only (never `.method(...)`/`.new(...)`) and to
  // all-keyword-or-all-positional call sites — a call with any `name:`
  // argument parses as `Expr::CallKw` instead, never mixed with `Args`.
  <l:@L> <name:Ident> "(" <kwargs:CallKwArgs> ")" <r:@R> => Spanned { span: (l, r), node: Expr::CallKw(name, kwargs) },
  // `new` is a reserved keyword (see plan 08's Decision log): LALRPOP
  // tokenizes the literal `"new"` distinctly from the generic `Ident`
  // regex wherever it appears verbatim, so this and the bare
  // `recv "." Ident` alternative below never compete for the same
  // lookahead token.
  <l:@L> <recv:Ident> "." "new" "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::New(recv, args) },
  <l:@L> <recv:Ident> "." "spawn" "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Spawn(recv, args) },
  // Plan 60's Decision log: see `PrimaryExpr`'s own identical `.remote`
  // alternative for the full rationale.
  <l:@L> <class:Ident> "." "remote" "(" <addr:Expr> "," <name:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Remote { class, addr: Box::new(addr), name: Box::new(name) } },
  <l:@L> "Array" "." "new" "(" <size:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::ArrayNew(Box::new(size)) },
  <l:@L> "Ok" "(" <e:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Ok(Box::new(e)) },
  <l:@L> "Err" "(" <e:Expr> ")" <r:@R> => Spanned { span: (l, r), node: Expr::Err(Box::new(e)) },
  // Plan 57's Decision log: see `StmtPrimaryExpr`'s own identical
  // `"supervise" "do" ... "end"` alternative for the full rationale.
  <l:@L> "supervise" "do" <body:Stmt*> "end" <r:@R> => Spanned { span: (l, r), node: Expr::Supervise(body) },
  <l:@L> <recv:Ident> "." <method:CallMethodName> "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, args) },
  <l:@L> <recv:Ident> "." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, vec![]) },
  // Plan 55's Decision log: see `StmtPrimaryExpr`'s own identical
  // `InstanceVarTok`-headed mirror alternative for the full rationale.
  <l:@L> <recv:InstanceVarTok> "." <method:CallMethodName> "(" <args:Args> ")" <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::InstanceVar(recv))), method, args) },
  <l:@L> <recv:InstanceVarTok> "." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::MethodCall(Box::new(Spanned::synthetic(Expr::InstanceVar(recv))), method, vec![]) },
  // Plan 43's Decision log: mirrors the two `MethodCall` alternatives
  // immediately above exactly, `"&."` in place of `"."`.
  <l:@L> <recv:Ident> "&." <method:CallMethodName> "(" <args:Args> ")" <r:@R> => {
    Spanned { span: (l, r), node: Expr::SafeCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, args) }
  },
  <l:@L> <recv:Ident> "&." <method:CallMethodName> <r:@R> => Spanned { span: (l, r), node: Expr::SafeCall(Box::new(Spanned::synthetic(Expr::Ident(recv))), method, vec![]) },
  <l:@L> "[" <elements:Args> "]" <r:@R> => Spanned { span: (l, r), node: Expr::ArrayLit(elements) },
  // `->(params) -> ReturnType { body }` — plan 10's lambda literal.
  // `"->"` doesn't start any other `PrimaryExpr` alternative, so this
  // can't collide with the FuncDef-return-arrow usage of `"->"` or
  // anything else. `{`/`}` are no longer this grammar's only brace use
  // (plan 25's `HashPairs` below is the other) — this production's `{`
  // only ever appears after `"->" "(" ... ")" "->" TypeName` is already
  // consumed, never as `PrimaryExpr`'s own first token, so it's in a
  // disjoint parser state from `HashPairs`' leading `"{"`.
  <l:@L> "->" "(" <params:Params> ")" "->" <return_type:TypeName> "{" <body:Stmt*> "}" <r:@R> => Spanned { span: (l, r), node: Expr::Lambda {
    params,
    return_type,
    body,
  }},
  <l:@L> <f:FloatLit> <r:@R> => Spanned { span: (l, r), node: Expr::Float(f) },
  <l:@L> <n:Num> <r:@R> => Spanned { span: (l, r), node: Expr::Int(n) },
  <l:@L> <s:StringLitTok> <r:@R> =>? interpolate::parse_interpolated_string(&s)
    .map(|node| Spanned { span: (l, r), node })
    .map_err(|error| lalrpop_util::ParseError::User { error }),
  <l:@L> <s:SymbolLitTok> <r:@R> => Spanned { span: (l, r), node: Expr::SymbolLit(s) },
  <l:@L> "true" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(true) },
  <l:@L> "false" <r:@R> => Spanned { span: (l, r), node: Expr::Bool(false) },
  <l:@L> "nil" <r:@R> => Spanned { span: (l, r), node: Expr::Nil },
  <l:@L> "{" <pairs:HashPairs> "}" <r:@R> => Spanned { span: (l, r), node: Expr::HashLit(pairs) },
  <l:@L> <name:InstanceVarTok> <r:@R> => Spanned { span: (l, r), node: Expr::InstanceVar(name) },
  <l:@L> <name:Ident> <r:@R> => Spanned { span: (l, r), node: Expr::Ident(name) },
};

// Plan 18: widened from `CallExpr` to the full `Expr` — a call argument
// (`factorial(n - 1)`) needs the whole precedence ladder, not just
// postfix indexing. No ambiguity from this widening: every use of
// `Args` is already delimited by `(`/`)` or `[`/`]` with `,` separators,
// so there's no bare-leading-token collision the `Stmt`-initial split
// exists to avoid.
Args: Vec<Spanned<Expr>> = {
  <mut v:(<Expr> ",")*> <last:Expr?> => {
    match last {
      None => v,
      Some(e) => { v.push(e); v }
    }
  }
};

Params: Vec<Param> = {
  <mut v:(<Param> ",")*> <last:Param?> => {
    match last {
      None => v,
      Some(p) => { v.push(p); v }
    }
  }
};

Param: Param = {
  <name:Ident> ":" <ty:TypeName> => Param { name, ty, default: None }
};

// `Array` is a reserved keyword (same LALR(1) reason `puts`/`new` were
// reserved in plans 07/08): the literal `"Array"` token is tokenized
// distinctly from the generic `Ident` regex, so this alternative and the
// bare-`Ident` one below never compete for the same lookahead token.
// `Param.ty`/`Function.return_type` stay a plain `String` — a compound
// name like `"Array[Int64]"` is grammar-level concatenation, not a
// structured type AST node yet (see plan 09's Decision log).
// `Proc` is reserved the same way (plan 10): a bare, unparameterized
// annotation — `Type::Proc`'s actual signature is recovered sema-side
// from the `Expr::Lambda` it's bound to, not from this string (plan 10's
// Decision log — no `Proc[(Int64) -> Int64]` compound grammar).
// `Hash` is reserved the same way `Array` is (plan 25) — `K`/`V` stay
// plain `Ident`s, same `Int64`-key-only restriction this plan's
// Decision log applies at the sema level; the grammar itself doesn't
// need to enforce that narrowing (it's just a name here, same as
// `Array[Elem]`'s own compound-string convention, plan 09's Decision
// log).
// Plan 43's Decision log: `<base:TypeName> "?"` is ordinary left
// recursion (the same shape every other left-recursive production in
// this grammar already uses, e.g. `AddExpr`) — `"?"` is a genuinely new
// terminal, not reused from anywhere else. `Type::Nullable`'s own
// reference-type-only restriction (rejecting `Int64?`/`Float64?`/
// `Boolean?`/`Proc?`) is entirely `resolve_type`'s job, not the
// grammar's — `T?` stays a plain compound-string annotation here,
// mirroring `Array[Elem]`/`Hash[K, V]`'s own convention (plan 09's
// Decision log).
TypeName: String = {
  <name:Ident> => name,
  "Array" "[" <elem:Ident> "]" => format!("Array[{elem}]"),
  "Hash" "[" <k:Ident> "," <v:Ident> "]" => format!("Hash[{k}, {v}]"),
  // Plan 42's Decision log: `Pair[K, V]` — the identical compound-
  // string convention `Hash[K, V]` above already uses. Never source-
  // constructible as a VALUE (only `Hash[K,V].each`'s own generated
  // Proc argument ever produces one), but its TYPE annotation must
  // still parse — it's the only way to declare a `Hash.each` Proc's
  // own parameter type.
  "Pair" "[" <k:Ident> "," <v:Ident> "]" => format!("Pair[{k}, {v}]"),
  // Plan 53's Decision log: `Result[T, E]`, the identical `,`-split
  // compound-string convention `Hash[K, V]` already uses — `resolve_type`
  // is the thing that turns this into a real `Type::Result`.
  "Result" "[" <t:Ident> "," <e:Ident> "]" => format!("Result[{t}, {e}]"),
  "Proc" => "Proc".to_string(),
  <base:TypeName> "?" => format!("{base}?"),
  // Plan 39's Decision log: `"(" T1 "," T2 [, ...] ")"`, mirroring
  // `Array[Elem]`/`Hash[K, V]`'s own compound-string convention
  // (formatted as e.g. `"(Int64, Int64)"`). Added as a grammar-wide
  // `TypeName` alternative, not gated to only the return-type
  // position — the actual restriction (only a function's declared
  // return type may ever be a tuple) lives entirely in sema's
  // `resolve_return_type` vs. the shared `resolve_type` (used for
  // every param/field/`Let` annotation, which never resolves this
  // shape and falls through to its `unknown type` catch-all).
  "(" <parts:TupleTypeNames> ")" => format!("({})", parts.join(", ")),
  // Plan 58's Decision log: a general `<Ident> "[" ... "]"` compound
  // form for a user-declared generic class (`Stack[Int64]`,
  // `Box[Box[Int64]]`) — distinct from the four hardcoded-keyword
  // forms above (`Array`/`Hash`/`Pair`/`Result` are reserved terminals,
  // never matched by the plain `Ident` regex, so there is no FIRST-set
  // overlap to disambiguate: LALR(1) picks this alternative purely by
  // whether a `[` follows the identifier). Deliberately accepts a full
  // recursive `TypeName` per type argument (`GenericTypeArgs`), NOT the
  // narrower bare-`Ident`-only convention the four hardcoded forms use
  // above — `Box[Box[Int64]]` must parse as a single compound string
  // for this plan's own recursive-instantiation hazard to ever reach
  // sema at all (see the plan's own Decision log).
  <name:Ident> "[" <args:GenericTypeArgs> "]" => format!("{name}[{}]", args.join(", ")),
};

// Plan 58: one-or-more comma-separated `TypeName`s (unlike
// `TupleTypeNames`'s "at least two" — a single-type-parameter generic
// class, `Stack[Int64]`, is the common case). Right-recursive, mirroring
// every other separator-delimited list in this grammar.
GenericTypeArgs: Vec<String> = {
  <t:TypeName> => vec![t],
  <t:TypeName> "," <rest:GenericTypeArgs> => {
    let mut v = vec![t];
    v.extend(rest);
    v
  },
};

// At least two element types (a 1-tuple isn't a meaningful multi-return
// shape) — same mandatory-first-element, right-recursive idiom as
// `MultiAssignNames`/`YieldArgs` elsewhere in this grammar.
TupleTypeNames: Vec<String> = {
  <first:TypeName> "," <last:TypeName> => vec![first, last],
  <first:TypeName> "," <rest:TupleTypeNames> => {
    let mut v = vec![first];
    v.extend(rest);
    v
  },
};

Num: i64 = <s:r"[0-9]+"> => s.parse().unwrap();

// No exponent notation, no bare-trailing-dot forms — matches only what
// `2.0`/`3.0` need (plan 08's Implementation Notes).
FloatLit: f64 = <s:r"[0-9]+\.[0-9]+"> => s.parse().unwrap();

Ident: String = <s:r"[A-Za-z_][A-Za-z0-9_]*"> => s.to_string();

// `@name` — strips the leading `@` in the action.
InstanceVarTok: String = <s:r"@[A-Za-z_][A-Za-z0-9_]*"> => s[1..].to_string();

// Plan 19: `"..."` — content is a run of any byte except `"`/`\`, or one
// of the two recognized two-byte escapes (`\"`, `\n`). No other
// backslash sequence is admitted by this regex at all, so `"\t"` (an
// unrecognized escape) or an unterminated `"` with no closing quote
// simply fails to match any token here — a real parse error (an
// "invalid token"/"unrecognized EOF" from LALRPOP), never a silent
// pass-through or a panic. `decode_string_lit` (above `grammar;`)
// strips the quotes and decodes the two escapes into the literal's real
// `String` value.
StringLitTok: String = <s:r#""([^"\\]|\\[n"])*""#> => decode_string_lit(&s);

// Plan 44's Decision log: LALRPOP's tokenizer picks the longest match
// at a given position — this 6+-character regex wins over the
// pre-existing bare `":"` literal token (`Stmt`'s `name: Type = ...`,
// `Param`'s `name: Type`) only when a `:` is immediately followed by an
// identifier with NO space between them (`x:Int64`, not `x: Int64`) —
// a real, disclosed, narrow restriction (this codebase's own
// convention, and every existing example/test fixture, always writes a
// space there; grepped this session for the collision shape with zero
// matches), not a silent landmine. Strips the leading `:` in the
// action, mirroring `decode_string_lit`'s "AST holds the real value"
// convention.
SymbolLitTok: String = <s:r":[A-Za-z_][A-Za-z0-9_]*"> => s[1..].to_string();
